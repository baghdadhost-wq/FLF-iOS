+-- OpenLF2 iOS build: whether one Defend sequence ("Fa", "Ua", "Da", "Fj", "Uj", "Dj", "ja") could start a
+-- move for `value`'s fighter now; the touch "moves" panel enables its buttons from this.
+function control.move_available(value, field)
+    if not value or not value.record then return false end
+    local frame = value.record.frame(value.frame)
+    local candidates = {frame.hits}
+    if frame.hits.d ~= 0 then candidates[2] = value.record.frame(frame.hits.d).hits end
+    for _, hits in ipairs(candidates) do
+        if hits[field] ~= 0 and value.weapon ~= record_kinds.heavy_item and (field ~= "ja" or value.transform == -1) then return true end
+    end
+    return field == "ja" and value.twin == fusion_merged
+end
+-- Whether `value`'s fighter faces left.
+function control.faces_left(value) return value ~= nil and value.facing == facing_left end
